{
  "name": "dsh-newapi-meter",
  "version": "1.7.0-newapi.5",
  "description": "DeepSeek Harness 会话费用统计插件(new-api 分支):本会话成本、当日费用、历史记录与官方价格同步,支持多厂商多模型价格计费(内置 90+ 模型价格目录与自动匹配)、网关站点额度查询(one-api / new-api / sub2api 自动识别,额度/已用/剩余 + 进度条,站点与 Key 取自 DSH「模型」设置里的 provider)、Coding Plan 订阅额度查询与显示、自定义 Provider 余额查询、峰谷计价时段显示与切换前弹窗/系统通知提醒,界面中英双语。Fork of dsh-cost-meter whose Go-quota card now reads the total/used quota of a self-hosted gateway (one-api / new-api / sub2api, auto-detected and persisted per provider) using the base URL and API key of a provider configured under Settings → Models.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-newapi-meter",
    "summary": "DeepSeek Harness 会话费用统计(new-api 定制分支):本会话费用、预算图框、官方余额、new-api 站点额度(总额/已用/剩余 + 进度条,站点与 Key 取自 设置→模型 的 provider)、Coding Plan 额度查询、历史记录,支持峰谷计价与官方价格一键同步。",
    "categories": [
      "费用",
      "Web UI",
      "观测"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "service:cost-meter"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5",
      "node": ">=20"
    },
    "permissions": {
      "network": [
        "https://api.deepseek.com",
        "https://api-docs.deepseek.com",
        "https://open.volcengineapi.com",
        "https://ark.cn-beijing.volces.com",
        "https://opencode.ai",
        "https://api.anthropic.com",
        "https://api.z.ai",
        "https://open.bigmodel.cn",
        "https://www.minimaxi.com",
        "https://www.minimax.io",
        "https://api.kimi.com",
        "https://api.moonshot.cn",
        "https://openrouter.ai",
        "https://api.siliconflow.cn",
        "https://api.commandcode.ai",
        "https://ax.ac.sugon.com"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/provider-pricing.json"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "zod": "4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycm50/dsh-subscribe-meter.git"
  },
  "homepage": "https://github.com/ycm50/dsh-subscribe-meter/tree/new-api#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "cost",
    "usage",
    "billing",
    "commandcode",
    "goat",
    "quota",
    "i18n",
    "bilingual",
    "zh",
    "en"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/verify-typert.mjs",
    "prepublishOnly": "node scripts/verify-typert.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
